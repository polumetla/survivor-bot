{
  "name": "survivor-bot",
  "version": "0.1.0",
  "description": "NFL survivor pool pick predictor and season planner with optional Splash Sports import",
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch src/server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "tsx src/server/index.ts",
    "suggest": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polumetla/survivor-bot.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/polumetla/survivor-bot/issues"
  },
  "homepage": "https://github.com/polumetla/survivor-bot#readme",
  "dependencies": {
    "express": "^4.22.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "type": "module",
  "private": true
}
